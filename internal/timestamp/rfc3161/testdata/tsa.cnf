[ tsa ]
default_tsa = tsa_config

[ tsa_config ]
serial = $ENV::RFC3161_FIXTURE_TMP/serial
crypto_device = builtin
signer_cert = $ENV::RFC3161_FIXTURE_TMP/tsa.pem
certs = $ENV::RFC3161_FIXTURE_TMP/root.pem
signer_key = $ENV::RFC3161_FIXTURE_TMP/tsa-key.pem
signer_digest = sha256
default_policy = 1.3.6.1.4.1.55555.1
other_policies = 1.3.6.1.4.1.55555.2
digests = sha256
accuracy = secs:1
ordering = no
tsa_name = yes
ess_cert_id_chain = yes
ess_cert_id_alg = sha256
