            "type": "string"
          },
          "type": "array"
        },
        "state": {
          "enum": [
            "none",
            "complete",
            "pending",
            "retained",
            "required"
          ]
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "warnings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "type": "array"
