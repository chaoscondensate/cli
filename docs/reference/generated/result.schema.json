  "$id": "https://chaoscondensate.com/schemas/forecast-ledger-cli/result/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string"
    },
    "data": {
      "description": "Operation-specific public data; timestamp.verify uses $defs.timestampVerificationData.",
      "type": "object"
    },
    "effects": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "read",
              "create",
              "replace",
              "remove",
              "contact"
            ]
          },
          "kind": {
            "enum": [
              "ledger",
              "target",
              "receipt",
              "key",
              "package",
              "network"
            ]
          },
          "owned": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "rollback": {
            "enum": [
              "none",
              "created_public",
              "retain_secret"
            ]
          },
          "root": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "deferred",
              "completed",
              "unchanged"
            ]
          }
        },
        "required": [
          "kind",
          "action",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "message": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
